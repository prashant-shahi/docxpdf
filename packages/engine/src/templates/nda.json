        "bold": true
      },
      {
        "id": 5,
        "type": "text",
        "x": 60,
        "y": 138,
        "width": 475,
        "height": 24,
        "content": "Receiving Party: [Name/Company]",
        "fontSize": 11,
        "fontFamily": "Arial",
        "color": "#333",
        "bold": true
      },
      {
        "id": 6,
        "type": "text",
        "x": 60,
        "y": 170,
        "width": 475,
        "height": 25,
        "content": "1. Definition of Confidential Information",
        "fontSize": 12,
        "fontFamily": "Georgia",
        "color": "#1a1a1a",
        "bold": true
      },
      {
        "id": 7,
        "type": "text",
        "x": 60,
        "y": 192,
        "width": 475,
        "height": 60,
        "content": "\"Confidential Information\" means any information disclosed by either party to the other, whether orally or in writing, that is designated as confidential or that reasonably should be understood to be confidential given the nature of the information and circumstances of disclosure. This includes, but is not limited to: business plans, financial data, customer lists, technical data, trade secrets, and product specifications.",
        "fontSize": 11,
        "fontFamily": "Arial",
        "color": "#444"
      },
      {
        "id": 8,
        "type": "text",
        "x": 60,
        "y": 280,
        "width": 475,
        "height": 25,
        "content": "2. Obligations of Receiving Party",
        "fontSize": 12,
        "fontFamily": "Georgia",
        "color": "#1a1a1a",
        "bold": true
      },
      {
        "id": 9,
        "type": "text",
        "x": 60,
        "y": 302,
        "width": 475,
        "height": 114,
        "content": "The Receiving Party agrees to:\n\u2022 Maintain the Confidential Information in strict confidence\n\u2022 Not disclose Confidential Information to any third party without prior written consent\n\u2022 Use Confidential Information solely for the purpose of the business relationship\n\u2022 Limit access to Confidential Information to employees who need to know\n\u2022 Return or destroy Confidential Information upon request",
        "fontSize": 11,
        "fontFamily": "Arial",
        "color": "#444"
      },
      {
        "id": 10,
        "type": "text",
        "x": 60,
        "y": 400,
        "width": 475,
        "height": 25,
        "content": "3. Exclusions",
        "fontSize": 12,
        "fontFamily": "Georgia",
        "color": "#1a1a1a",
        "bold": true
      },
      {
        "id": 11,
        "type": "text",
        "x": 60,
        "y": 422,
        "width": 475,
        "height": 50,
        "content": "Confidential Information does not include information that: (a) is or becomes publicly available without breach of this Agreement; (b) was known to the Receiving Party prior to disclosure; (c) is independently developed by the Receiving Party; or (d) is required to be disclosed by law.",
        "fontSize": 11,
        "fontFamily": "Arial",
        "color": "#444"
      },
      {
        "id": 12,
        "type": "text",
        "x": 60,
        "y": 500,
        "width": 475,
        "height": 25,
        "content": "4. Term",
        "fontSize": 12,
        "fontFamily": "Georgia",
        "color": "#1a1a1a",
        "bold": true
      },
      {
        "id": 13,
        "type": "text",
        "x": 60,
        "y": 522,
        "width": 475,
        "height": 30,
        "content": "This Agreement shall remain in effect for [X] years from the date of signing. The obligations of confidentiality shall survive for [X] years after termination.",
        "fontSize": 11,
        "fontFamily": "Arial",
        "color": "#444"
      },
      {
        "id": 14,
        "type": "text",
        "x": 60,
        "y": 570,

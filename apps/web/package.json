{
    "private": true,
    "name": "docxpdf-frontend",
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "typecheck": "svelte-kit sync && tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "svelte-kit sync && playwright test",
        "test:e2e:ui": "svelte-kit sync && playwright test --ui",
        "test:coverage": "vitest run --coverage",
        "lint": "prettier --check . && eslint .",
        "svelte-check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
        "format": "prettier --write ."
    },
    "devDependencies": {
        "@playwright/test": "^1.62.0",
        "@sveltejs/adapter-static": "^3.0.8",
        "@sveltejs/kit": "^2.70.1",
        "@sveltejs/vite-plugin-svelte": "^7.2.0",
        "@testing-library/jest-dom": "^7.0.0",
        "@testing-library/svelte": "^5.4.2",
        "@types/node": "^26.1.2",
        "@typescript/native": "npm:typescript@7.0.2",
        "@typescript/native-preview": "npm:typescript@7.0.2",
        "@vitest/coverage-v8": "^4.1.10",
        "autoprefixer": "^10.5.4",
        "concurrently": "^10.0.4",
        "fake-indexeddb": "^6.2.5",
        "jsdom": "^30.0.1",
        "postcss": "^8.5.25",
        "prettier": "^3.9.6",
        "prettier-plugin-svelte": "^4.1.1",
        "svelte": "^5.56.8",
        "svelte-check": "4.7.4",
        "tailwindcss": "^3.4.17",
        "typescript": "~6.0.2",
        "vite": "^8.1.5",
        "vitest": "^3.2.6",
        "wrangler": "^4.115.0"
    },
    "dependencies": {
        "@docxpdf/engine": "workspace:*",
        "interactjs": "^1.10.28",
        "jszip": "^3.10.1"
    }
}
